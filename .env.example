# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Order emails (optional). https://resend.com
RESEND_API_KEY=
# One address or several, comma-separated.
ORDER_NOTIFY_EMAIL=you@example.com,partner@example.com
# Defaults to Resend's test sender until you verify a domain.
ORDER_NOTIFY_FROM=LuckyDayze <orders@yourdomain.com>

# Staff push alerts. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
